# Copy to .env and fill in. Everything except the API keys has a working default.

# AI providers (needed for pasted problems; the library works without them).
# Free keys: Gemini at https://aistudio.google.com, Groq at https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional, for paid providers:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model per pipeline role, as provider:model (providers: gemini, groq, anthropic, openai).
# Brute A and Brute B must differ (startup fails otherwise); a different provider is best.
ALGOLENS_MODEL_PARSE=gemini:gemini-2.5-flash
ALGOLENS_MODEL_BRUTE_A=gemini:gemini-2.5-flash
ALGOLENS_MODEL_BRUTE_B=groq:openai/gpt-oss-120b
ALGOLENS_MODEL_APPROACHES=gemini:gemini-2.5-flash
ALGOLENS_MODEL_CHECKER=gemini:gemini-2.5-flash
ALGOLENS_MODEL_REPAIR=gemini:gemini-2.5-flash
ALGOLENS_MODEL_NARRATION=gemini:gemini-2.5-flash

# Per-problem AI budget: input + output tokens across all calls (plan §6.4).
ALGOLENS_MAX_TOKENS_PER_PROBLEM=200000
ALGOLENS_MAX_REPAIR_ROUNDS=2
