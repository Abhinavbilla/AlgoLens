# Copy to .env and fill in. Everything except the API key has a working default.

# Needed from M5 (AI pipeline). The library works without it.
ANTHROPIC_API_KEY=

# Per-problem AI budget: input + output tokens across all calls (plan §6.4).
ALGOLENS_MAX_TOKENS_PER_PROBLEM=200000
ALGOLENS_MAX_REPAIR_ROUNDS=2

# Model per pipeline role. Brute A and Brute B must differ (startup fails otherwise).
ALGOLENS_MODEL_PARSE=claude-sonnet-5-5
ALGOLENS_MODEL_BRUTE_A=claude-sonnet-5-5
ALGOLENS_MODEL_BRUTE_B=claude-opus-5-5
ALGOLENS_MODEL_APPROACHES=claude-sonnet-5-5
ALGOLENS_MODEL_CHECKER=claude-sonnet-5-5
ALGOLENS_MODEL_REPAIR=claude-opus-5-5
ALGOLENS_MODEL_NARRATION=claude-sonnet-5-5
