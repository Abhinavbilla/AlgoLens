# Copy to .env and fill in. Everything except the API keys has a working default.

# AI providers (needed for pasted problems; the library works without them).
# Free keys: Gemini at https://aistudio.google.com, Groq at https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional, for paid providers:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model per pipeline role, as provider:model (providers: gemini, groq, anthropic, openai).
# Brute A and Brute B must differ (startup fails otherwise); a different provider is best.
ALGOLENS_MODEL_PARSE=gemini:gemini-3.8-flash
ALGOLENS_MODEL_BRUTE_A=gemini:gemini-3.8-flash
ALGOLENS_MODEL_BRUTE_B=groq:openai/gpt-oss-120b
ALGOLENS_MODEL_APPROACHES=gemini:gemini-3.8-flash
ALGOLENS_MODEL_CHECKER=gemini:gemini-3.8-flash
ALGOLENS_MODEL_REPAIR=gemini:gemini-3.8-flash
ALGOLENS_MODEL_NARRATION=gemini:gemini-3.8-flash
# The tutor chat on algorithm and problem pages (empty: same as narration). A model of its
# own keeps chatting from using up the solver's daily free-tier quota.
ALGOLENS_MODEL_TUTOR=

# Per-problem AI budget: input + output tokens across all calls (plan §6.4).
ALGOLENS_MAX_TOKENS_PER_PROBLEM=200000
# New problems each visitor may have solved in 24 hours (only verified results count; 0 = no limit).
ALGOLENS_PROBLEMS_PER_DAY=3
ALGOLENS_PROBLEMS_PER_DAY_SIGNED_IN=6
ALGOLENS_MAX_REPAIR_ROUNDS=2

# Optional Google sign-in (progress across devices, "Your problems", higher tutor limits).
# Without these the site works as usual and shows no sign-in button. Create an OAuth client
# ("Web application") at https://console.cloud.google.com/apis/credentials with the redirect
# URI <ALGOLENS_PUBLIC_URL>/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the site is reached. An https address also makes the session cookie Secure.
ALGOLENS_PUBLIC_URL=http://localhost:8080

# Optional sign-in with an emailed 6-digit code (alongside or instead of Google). Any SMTP
# service works, e.g. Gmail (smtp.gmail.com, 587, an App Password), Brevo or Resend.
ALGOLENS_SMTP_HOST=
ALGOLENS_SMTP_PORT=587
ALGOLENS_SMTP_USER=
ALGOLENS_MAIL_FROM=
SMTP_PASSWORD=
# Local testing only: write codes to the API log instead of sending them. Never in production.
ALGOLENS_EMAIL_DEV_LOG=false
