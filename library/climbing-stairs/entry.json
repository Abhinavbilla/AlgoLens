  "narration": [
    {
      "line": 2,
      "text": "ways[i] will count the ways to reach step i. There's exactly one way to be at the bottom, and one way to reach the first step."
    },
    {
      "line": 3,
      "next": 4,
      "text": "Step {i}: you get there either from step {i - 1} or from step {i - 2}."
    },
    {
      "line": 3,
      "next": 5,
      "text": "Every step is counted."
    },
    {
      "line": 4,
      "text": "So the ways to reach step {i} are {ways[i - 1] + ways[i - 2]}."
    },
    {
      "line": 5,
      "text": "There are {ways[n]} ways to climb {n} steps."
    }
  ]
