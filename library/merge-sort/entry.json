    {"line": 10, "next": 11, "text": "{left[i]} ≤ {right[j]}: take {left[i]} from the left half."},
    {"line": 10, "next": 14, "text": "{right[j]} < {left[i]}: take {right[j]} from the right half."},
    {"line": 11, "text": "Merged so far: {merged}."},
    {"line": 12, "text": "Move along the left half."},
    {"line": 14, "text": "Merged so far: {merged}."},
    {"line": 15, "text": "Move along the right half."},
    {"line": 16, "text": "Add whatever is left of the left half: {merged}."},
    {"line": 17, "text": "Add whatever is left of the right half: {merged}."},
    {"line": 18, "text": "Return the merged list, {merged}."}
