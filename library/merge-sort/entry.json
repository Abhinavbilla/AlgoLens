  "narration": [
    {"line": 2, "next": 3, "text": "{arr} has at most one value, so it's already sorted."},
    {"line": 2, "next": 4, "text": "{arr} needs sorting: split it in two."},
    {"line": 3, "text": "Hand {arr} back unchanged."},
    {"line": 4, "text": "The right half starts at position {mid}."},
