  "narration": [
    {"line": 2, "text": "The map starts empty: no values seen yet."},
    {"line": 3, "next": 4, "text": "Look at position {j}, holding {nums[j]}."},
    {"line": 3, "next": 8, "text": "Every value has been checked."},
    {"line": 4, "text": "Its partner would have to be {target - nums[j]}."},
    {"line": 5, "next": 6, "text": "{need} is already in the map: its partner was at position {seen[need]}."},
    {"line": 5, "next": 7, "text": "{need} isn't in the map, so no earlier value pairs with {nums[j]}."},
    {"line": 6, "text": "Found it: positions {seen[need]} and {j}."},
