{
  "title": "Depth-first search on a graph",
  "category": "Graphs and grids",
  "summary": "Go as deep as possible along unvisited neighbours, backing up only when a node has none left.",
  "order": 42,
  "entry": "dfs_order",
  "schema": {
    "params": [
      {"name": "n", "type": {"kind": "int", "min": 1, "max": 8}},
      {"name": "edges", "type": {"kind": "edges", "nodes": "n", "count": {"min": 0, "max": 10}}},
      {"name": "source", "type": {"kind": "int", "min": 0, "max": "n - 1"}}
    ]
  },
  "note": "Undirected edges; neighbours are tried in the order their edges are listed.",
  "default_input": {"args": [6, [[0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [2, 5]], 0]},
  "tests": [
    {"args": [1, [], 0]},
    {"args": [2, [], 1]},
    {"args": [2, [[0, 1]], 1]},
    {"args": [3, [[0, 1], [1, 2], [2, 0]], 0]},
    {"args": [6, [[0, 1], [0, 2], [1, 3], [2, 3], [3, 4], [2, 5]], 0]},
    {"args": [5, [[0, 1], [2, 3]], 2]},
    {"args": [4, [[0, 1], [1, 2], [2, 3]], 3]},
    {"args": [5, [[0, 4], [0, 3], [0, 2], [0, 1]], 0]},
    {"args": [4, [[0, 1], [1, 2], [0, 2]], 0]},
    {"args": [7, [[3, 1], [3, 5], [1, 0], [1, 2], [5, 4], [5, 6]], 3]}
  ],
  "cpp_lines": {"1": 15, "2": 16, "3": 17, "4": 18, "5": 19, "6": 21, "7": 22, "9": 4, "10": 6, "11": 7, "12": 8, "13": 9, "14": 10, "16": 23, "17": 24},
  "visual": {
    "panels": [
      {"kind": "graph", "label": "Graph", "nodes": "n", "edges": "edges", "pointers": [{"label": "u", "at": "u"}, {"label": "v", "at": "v"}], "marks": [{"label": "visited", "when": "visited[node]"}]},
      {"kind": "list", "var": "order", "label": "Visiting order"},
      {"kind": "vars", "vars": ["source", "u", "v"]}
    ]
  },
  "narration": [
    {"line": 2, "text": "Start an empty neighbour list for each of the {n} nodes."},
    {"line": 3, "next": 4, "text": "Edge between {a} and {b}."},
    {"line": 3, "next": 6, "text": "Every edge is in the neighbour lists."},
    {"line": 4, "text": "{b} is a neighbour of {a}."},
    {"line": 5, "text": "And {a} is a neighbour of {b}."},
    {"line": 6, "text": "No node has been visited yet."},
    {"line": 7, "text": "The visiting order starts empty."},
    {"line": 9, "text": "Define visit: go as deep as possible from a node before backing up."},
    {"line": 10, "text": "Arrive at node {u} and mark it visited, so we never come back to it."},
    {"line": 11, "text": "Record {u}: the order is now {order}."},
    {"line": 12, "next": 13, "text": "Look at {u}'s neighbour {v}."},
    {"line": 12, "next": "return", "text": "Every neighbour of {u} is done: back up."},
    {"line": 13, "next": 14, "text": "{v} hasn't been visited: go there now, before {u}'s other neighbours."},
    {"line": 13, "next": 12, "text": "{v} is already visited: skip it."},
    {"line": 14, "text": "Back at {u}, after exploring everything new that's reachable from {v}."},
    {"line": 16, "text": "Everything reachable from {source} has been visited."},
    {"line": 17, "text": "The depth-first order is {order}."}
  ]
}
