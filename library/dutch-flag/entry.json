  "narration": [
    {
      "line": 2,
      "text": "Three markers: zeros will collect before low, twos after high, and mid scans what's in between."
    },
    {
      "line": 3,
      "next": 4,
      "text": "mid hasn't passed high: look at {nums[mid]}."
    },
    {
      "line": 3,
      "next": 13,
      "text": "mid has passed high: every value is in its zone."
    },
    {
      "line": 4,
      "next": 5,
      "text": "It's a zero: swap it down to position {low}."
    },
    {
      "line": 4,
      "next": 8,
      "text": "It isn't a zero."
    },
    {
      "line": 5,
      "text": "Swapped: {nums}."
    },
    {
      "line": 6,
      "text": "The zeros now fill everything before position {low}."
    },
    {
      "line": 7,
      "text": "Move on to position {mid}."
    },
    {
      "line": 8,
      "next": 9,
      "text": "It's a one: ones belong in the middle, so it stays."
    },
    {
      "line": 8,
      "next": 11,
      "text": "It's a two: swap it up to position {high}."
    },
    {
      "line": 9,
      "text": "Move on to position {mid}."
    },
    {
      "line": 11,
      "text": "Swapped: {nums}."
    },
    {
      "line": 12,
      "text": "The twos now fill everything after position {high}. The value that just arrived at position {mid} still needs a look."
    },
    {
      "line": 13,
      "text": "Sorted in a single pass: {nums}."
    }
  ]
