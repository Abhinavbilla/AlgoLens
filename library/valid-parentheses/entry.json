        "([)]"
      ]
    },
    {
      "args": [
        "(("
      ]
    },
    {
      "args": [
        "))"
      ]
    },
    {
      "args": [
        "([])[]"
      ]
    },
    {
      "args": [
        "[(])"
      ]
    },
    {
      "args": [
        "[[]]()"
      ]
    }
  ],
  "cpp_lines": {
    "2": 4,
    "3": 5,
    "4": 6,
    "5": 7,
    "6": 8,
    "7": 9,
    "8": 11,
    "10": 13,
    "11": 16
