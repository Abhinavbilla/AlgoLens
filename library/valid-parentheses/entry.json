{
  "title": "Stacks: matching brackets",
  "category": "Stacks",
  "summary": "Push every opening bracket; each closing bracket must match the one on top of the stack.",
  "order": 39,
  "entry": "is_valid",
  "schema": {
    "params": [
      {
        "name": "s",
        "type": {
          "kind": "string",
          "chars": "()[]",
          "len": {
            "min": 0,
            "max": 10
          }
        }
      }
    ]
  },
  "default_input": {
    "args": [
      "([])[]"
    ]
  },
  "tests": [
