{
  "title": "Longest increasing subsequence",
  "category": "Dynamic programming",
  "summary": "For each position, the longest increasing run ending there is one more than the best earlier run it can extend.",
  "order": 60,
  "entry": "lis",
  "schema": {
    "params": [
      {
        "name": "nums",
        "type": {
          "kind": "array",
          "of": {
            "kind": "int",
            "min": 0,
            "max": 20
          },
          "len": {
            "min": 0,
            "max": 8
          }
        }
      }
    ]
  },
  "default_input": {
