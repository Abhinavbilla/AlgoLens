  "narration": [
    {"line": 2, "text": "No subsets found yet."},
    {"line": 3, "text": "The current subset starts empty."},
    {"line": 5, "text": "Define the recursive helper: it records the current subset, then tries adding each remaining number."},
    {"line": 6, "text": "Record {path} as a subset."},
    {"line": 7, "next": 8, "text": "Try adding {nums[i]}."},
    {"line": 7, "next": "return", "text": "No more numbers to add here, so go back up."},
    {"line": 8, "text": "Add {nums[i]}: the subset is now {path}."},
