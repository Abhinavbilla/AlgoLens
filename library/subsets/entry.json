    {"args": [[1, 2, 3]]},
    {"args": [[0, -1, 1]]},
    {"args": [[4, 3, 2, 1]]},
    {"args": [[-10, 10]]}
  ],
  "cpp_lines": {"2": 17, "3": 18, "6": 8, "7": 9, "8": 10, "9": 11, "10": 12, "12": 19, "13": 20},
  "visual": {
    "panels": [
      {"kind": "array", "var": "nums", "pointers": [{"label": "i", "at": "i"}, {"label": "start", "at": "start"}]},
